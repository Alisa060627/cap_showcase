{
  "name": "cap_showcase",
  "version": "1.0.0",
  "description": "A simple CAP project.",
  "dependencies": {
    "@sap/cds": "^9",
    "express": "^4"
  },
  "cds": {
    "requires": {
      "[development]": {
        "auth": {
          "kind": "mocked",
          "users": {
            "alice": {
              "roles": [
                "support"
              ]
            },
            "bob": {
              "roles": [
                "support"
              ]
            }
          }
        }
      }
    }
  },
  "devDependencies": {
    "@cap-js/cds-test": "^0.4.1",
    "@cap-js/sqlite": "^2",
    "cds-plugin-ui5": "^0.13.0"
  },
  "scripts": {
    "start": "cds-serve",
    "watch-cap_showcase_fiori": "cds watch --open cap.showcase.fiori.capshowcasefiori/index.html?sap-ui-xx-viewCache=false --livereload false",
    "watch-cap_showcase_ui": "cds watch --open cap.showcase.ui.capshowcaseui/index.html?sap-ui-xx-viewCache=false --livereload false",
    "watch-showcase_ui": "cds watch --open showcase.ui.showcaseui/index.html?sap-ui-xx-viewCache=false --livereload false",
    "watch-basic_ui": "cds watch --open basic.ui.basicui/index.html?sap-ui-xx-viewCache=false --livereload false",
    "test": "npx jest tests/test.js"
  },
  "private": true,
  "workspaces": [
    "app/*"
  ],
  "sapux": [
    "app/cap_showcase_fiori",
    "app/cap_showcase_ui",
    "app/showcase_ui"
  ]
}
